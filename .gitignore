.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
.DS_Store
# Every run's report, rebuilt from the corpus and the config; never hand-edited.
/analysis/
# Token-id caches an experiment writes next to itself so a rerun skips encoding.
experiments/**/*_ids.json
# Documents an experiment downloads once and caches next to itself.
experiments/**/*_documents.json
# Trained models: checkpoints are rebuilt by corpus-train from their config.
/runs/
# Syntactic diagnosis reports, rebuilt from the input corpora.
/diagnoses/
# Full per-cut readings of the settings sweeps (tens of MB each), rebuilt by each experiment's
# own commands; their summaries and READMEs are kept.
experiments/granularity_range/results/**/target_*.json
experiments/granularity_domains/results/**/target_*.json
experiments/ward_memory/results/vector/**/target_*.json
experiments/granularity_robustness/results/**/target_*.json
experiments/granularity_range/results/draw_count/pool.npz
experiments/class_induction/results/context_*.json
experiments/class_induction/results/classes_*.json
experiments/saturation/results/siblings/*.npz
experiments/subset_selection/results/diagnosis_*.json
# The paper's PDFs, built from paper/clean/paper-<lang>.md; shared as release assets, not committed.
paper/clean/Fura-Mendoza-*.pdf
